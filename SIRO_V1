#include <xc.h>
#include <stdlib.h>

// Configuración de fusibles PIC18F4550 (Cristal 4 MHz)
#pragma config PLLDIV = 1
#pragma config CPUDIV = OSC1_PLL2
#pragma config USBDIV = 1
#pragma config FOSC = HS
#pragma config FCMEN = OFF
#pragma config IESO = OFF
#pragma config PWRT = OFF
#pragma config BOR = OFF
#pragma config VREGEN = OFF
#pragma config WDT = OFF
#pragma config PBADEN = OFF
#pragma config MCLRE = ON
#pragma config LVP = OFF
#pragma config XINST = OFF

#define _XTAL_FREQ 4000000

// Variables globales del juego
int modo = 0; 
int boton_modo = 0;
int saludo_dado = 0; // Controla que "Hola Elias" suene solo la primera vez
int led_act = 0;    
int led_viejo = 0;
int hay_led_viejo = 0;
int led1 = 0;
int led2 = 0;
int led_anterior = 0;
int hay_led_anterior = 0;
int racha = 0;

// ==========================================================
// COMUNICACIÓN SERIAL BÁSICA (PIN RC6 -> RX DEL DFPLAYER)
// ==========================================================

void iniciar_serial_basico(void) {
    TRISC6 = 1;
    TRISC7 = 1;
    TXSTA = 0x24; // Activa transmisión
    RCSTA = 0x90; // Activa puerto serial en RC6
    SPBRG = 25;   // Velocidad 9600 baudios a 4 MHz
}

// Manda 1 byte usando int y espera 2 ms a que termine de salir
void enviar_byte(int dato) {
    TXREG = dato;
    __delay_ms(2);
}

// Manda los 10 bytes directos al DFPlayer según la pista
void reproducir_mp3(int pista) {
    if (pista == 0) { // Volumen al 100% (30 de 30 -> 0x1E)
        enviar_byte(0x7E); enviar_byte(0xFF); enviar_byte(0x06); enviar_byte(0x06); enviar_byte(0x00);
        enviar_byte(0x00); enviar_byte(0x1E); enviar_byte(0xFE); enviar_byte(0xD7); enviar_byte(0xEF);
    }
    if (pista == 1) { // 0001.mp3 -> Acierto
        enviar_byte(0x7E); enviar_byte(0xFF); enviar_byte(0x06); enviar_byte(0x03); enviar_byte(0x00);
        enviar_byte(0x00); enviar_byte(0x01); enviar_byte(0xFE); enviar_byte(0xF7); enviar_byte(0xEF);
    }
    if (pista == 2) { // 0002.mp3 -> Error
        enviar_byte(0x7E); enviar_byte(0xFF); enviar_byte(0x06); enviar_byte(0x03); enviar_byte(0x00);
        enviar_byte(0x00); enviar_byte(0x02); enviar_byte(0xFE); enviar_byte(0xF6); enviar_byte(0xEF);
    }
    if (pista == 3) { // 0003.mp3 -> Racha (5 aciertos)
        enviar_byte(0x7E); enviar_byte(0xFF); enviar_byte(0x06); enviar_byte(0x03); enviar_byte(0x00);
        enviar_byte(0x00); enviar_byte(0x03); enviar_byte(0xFE); enviar_byte(0xF5); enviar_byte(0xEF);
    }
    if (pista == 4) { // 0004.mp3 -> Voz: Izquierda
        enviar_byte(0x7E); enviar_byte(0xFF); enviar_byte(0x06); enviar_byte(0x03); enviar_byte(0x00);
        enviar_byte(0x00); enviar_byte(0x04); enviar_byte(0xFE); enviar_byte(0xF4); enviar_byte(0xEF);
    }
    if (pista == 5) { // 0005.mp3 -> Voz: En medio
        enviar_byte(0x7E); enviar_byte(0xFF); enviar_byte(0x06); enviar_byte(0x03); enviar_byte(0x00);
        enviar_byte(0x00); enviar_byte(0x05); enviar_byte(0xFE); enviar_byte(0xF3); enviar_byte(0xEF);
    }
    if (pista == 6) { // 0006.mp3 -> Voz: Derecha
        enviar_byte(0x7E); enviar_byte(0xFF); enviar_byte(0x06); enviar_byte(0x03); enviar_byte(0x00);
        enviar_byte(0x00); enviar_byte(0x06); enviar_byte(0xFE); enviar_byte(0xF2); enviar_byte(0xEF);
    }
    if (pista == 7) { // 0007.mp3 -> Voz: Subir de nivel
        enviar_byte(0x7E); enviar_byte(0xFF); enviar_byte(0x06); enviar_byte(0x03); enviar_byte(0x00);
        enviar_byte(0x00); enviar_byte(0x07); enviar_byte(0xFE); enviar_byte(0xF1); enviar_byte(0xEF);
    }
    if (pista == 8) { // 0008.mp3 -> Voz: Hola Elias
        enviar_byte(0x7E); enviar_byte(0xFF); enviar_byte(0x06); enviar_byte(0x03); enviar_byte(0x00);
        enviar_byte(0x00); enviar_byte(0x08); enviar_byte(0xFE); enviar_byte(0xF0); enviar_byte(0xEF);
    }
    if (pista == 9) { // 0009.mp3 -> Voz: Modo 1
        enviar_byte(0x7E); enviar_byte(0xFF); enviar_byte(0x06); enviar_byte(0x03); enviar_byte(0x00);
        enviar_byte(0x00); enviar_byte(0x09); enviar_byte(0xFE); enviar_byte(0xEF); enviar_byte(0xEF);
    }
    if (pista == 10) { // 0010.mp3 -> Voz: Modo 2
        enviar_byte(0x7E); enviar_byte(0xFF); enviar_byte(0x06); enviar_byte(0x03); enviar_byte(0x00);
        enviar_byte(0x00); enviar_byte(0x0A); enviar_byte(0xFE); enviar_byte(0xEE); enviar_byte(0xEF);
    }
}

// ==========================================================

void decir_zona(int led) {
    // En medio: LEDs 1, 2, 3 y 4 (índices 0, 1, 2 y 3)
    if (led <= 3) { reproducir_mp3(5); }

    // Izquierda: LEDs 5, 7 y 9 (índices 4, 6 y 8)
    if (led == 4) { reproducir_mp3(4); }
    if (led == 6) { reproducir_mp3(4); }
    if (led == 8) { reproducir_mp3(4); }

    // Derecha: LEDs 6, 8 y 10 (índices 5, 7 y 9)
    if (led == 5) { reproducir_mp3(6); }
    if (led == 7) { reproducir_mp3(6); }
    if (led == 9) { reproducir_mp3(6); }
}

void apagar_leds(void) {
    PORTD = 0x00;
    RC0 = 0; // LED 9
    RC1 = 0; // LED 10
}

void encender_todos_leds(void) {
    PORTD = 0xFF; // LEDs 1 a 8
    RC0 = 1;      // LED 9
    RC1 = 1;      // LED 10
}

void animacion_subir_nivel(void) {
    apagar_leds();
    __delay_ms(100);

    int rep = 0;
    while (rep < 3) {
        encender_todos_leds();
        __delay_ms(70);
        apagar_leds();
        __delay_ms(70);
        rep = rep + 1;
    }

    __delay_ms(80);

    encender_todos_leds();
    __delay_ms(250);
    apagar_leds();
    __delay_ms(150);
}

void sonido_bien(void) {
    racha = racha + 1;

    if (racha > 0 && racha % 10 == 0) {
        reproducir_mp3(7); // Voz de subir de nivel
        animacion_subir_nivel();
    } else {
        if (racha == 5) {
            reproducir_mp3(3); // Racha de 5
            __delay_ms(1200);  // Espera a que termine el audio de racha antes de decir la siguiente dirección
        } else {
            reproducir_mp3(1); // Acierto
        }
    }
}

void sonido_mal(void) {
    racha = 0;
    reproducir_mp3(2); // Error en el DFPlayer
}

void config_int(void) {
    INTEDG0 = 0;    
    INT0IF = 0;     
    INT0IE = 1;     
    GIE = 1;        
}

void __interrupt() ISR(void) {
    if (INT0IF == 1) {
        if (RB0 == 0) {
            modo = modo + 1;
            if (modo > 2) {
                modo = 0;
            }
            boton_modo = 1;
            racha = 0;
        }
        INT0IF = 0;
    }
}

void prender_led(int num) {
    switch(num) {
        case 0: RD0 = 1; break;
        case 1: RD1 = 1; break;
        case 2: RD2 = 1; break;
        case 3: RD3 = 1; break;
        case 4: RD4 = 1; break;
        case 5: RD5 = 1; break;
        case 6: RD6 = 1; break;
        case 7: RD7 = 1; break;
        case 8: RC0 = 1; break;
        case 9: RC1 = 1; break;
    }
}

void apagar_led(int num) {
    switch(num) {
        case 0: RD0 = 0; break;
        case 1: RD1 = 0; break;
        case 2: RD2 = 0; break;
        case 3: RD3 = 0; break;
        case 4: RD4 = 0; break;
        case 5: RD5 = 0; break;
        case 6: RD6 = 0; break;
        case 7: RD7 = 0; break;
        case 8: RC0 = 0; break;
        case 9: RC1 = 0; break;
    }
}

int leer_boton(int num) {
    switch(num) {
        case 0: return (RB1 == 0);
        case 1: return (RB2 == 0);
        case 2: return (RB3 == 0);
        case 3: return (RB4 == 0);
        case 4: return (RB5 == 0);
        case 5: return (RB6 == 0);
        case 6: return (RB7 == 0);
        case 7: return (RA0 == 0);
        case 8: return (RA1 == 0);
        case 9: return (RA2 == 0);
    }
    return 0;
}

void main(void) {

    ADCON1 = 0x0F; // Entradas digitales

    // Botones
    TRISB0 = 1; // Modo
    TRISB1 = 1; TRISB2 = 1; TRISB3 = 1; TRISB4 = 1;
    TRISB5 = 1; TRISB6 = 1; TRISB7 = 1;
    TRISA0 = 1; TRISA1 = 1; TRISA2 = 1;

    // LEDs
    TRISD = 0x00;
    TRISC0 = 0;
    TRISC1 = 0;

    // Arranca el serial básico y fija volumen al 100% (30) en el DFPlayer
    iniciar_serial_basico();
    __delay_ms(600);
    reproducir_mp3(0); // Volumen 100%
    __delay_ms(100);

    apagar_leds();
    config_int();

    while (1) {

        // Modo 0: Reposo
        if (modo == 0) {
            apagar_leds();
            boton_modo = 0;

            if (saludo_dado == 0) {
                reproducir_mp3(8); // 0008.mp3 -> "Hola Elias" solo la primera vez
                saludo_dado = 1;
            }

            while (modo == 0 && boton_modo == 0) {
                rand(); // Avanza la secuencia mientras está en reposo
                apagar_leds(); prender_led(8); __delay_ms(150);

                if (modo == 0 && boton_modo == 0) { apagar_leds(); prender_led(6); __delay_ms(150); }
                if (modo == 0 && boton_modo == 0) { apagar_leds(); prender_led(4); __delay_ms(150); }
                if (modo == 0 && boton_modo == 0) { apagar_leds(); prender_led(0); prender_led(2); __delay_ms(150); }
                if (modo == 0 && boton_modo == 0) { apagar_leds(); prender_led(1); prender_led(3); __delay_ms(150); }
                if (modo == 0 && boton_modo == 0) { apagar_leds(); prender_led(5); __delay_ms(150); }
                if (modo == 0 && boton_modo == 0) { apagar_leds(); prender_led(7); __delay_ms(150); }
                if (modo == 0 && boton_modo == 0) { apagar_leds(); prender_led(9); __delay_ms(150); }
            }

            apagar_leds();
        }

        // Modo 1: 10 LEDs aleatorios con voz por zona
        if (modo == 1) {
            boton_modo = 0;
            apagar_leds();
            hay_led_viejo = 0;

            reproducir_mp3(9); // 0009.mp3 -> Audio de Modo 1
            __delay_ms(2000);  // Espera 2 segundos a que termine el audio antes de prender el LED

            while (modo == 1 && boton_modo == 0) {

                led_act = rand() % 10;
                while (hay_led_viejo == 1 && led_act == led_viejo) {
                    led_act = rand() % 10;
                }

                __delay_ms(150);

                if (modo == 1 && boton_modo == 0) {
                    prender_led(led_act);
                    decir_zona(led_act);

                    int nivel_tiempo = racha / 10;
                    int tiempo_limite = 12000;

                    if (nivel_tiempo == 0) { tiempo_limite = 12000; } // 12 segundos
                    if (nivel_tiempo == 1) { tiempo_limite = 10000; } // 10 segundos
                    if (nivel_tiempo == 2) { tiempo_limite = 9000; }  // 9 segundos
                    if (nivel_tiempo > 2)  { tiempo_limite = 8000; }  // 8 segundos

                    int contador_tiempo = 0;
                    int respondio = 0;

                    while (respondio == 0 && modo == 1 && boton_modo == 0) {
                        rand(); // Avanza la secuencia mientras espera respuesta

                        if (leer_boton(led_act) == 1) {
                            apagar_led(led_act);
                            sonido_bien();
                            led_viejo = led_act;
                            hay_led_viejo = 1;
                            respondio = 1;
                        }

                        int i = 0;
                        while (i < 10) {
                            int prendido = 0;
                            if (i == led_act) { prendido = 1; }
                            if (hay_led_viejo == 1 && i == led_viejo && leer_boton(led_viejo) == 1) { prendido = 1; }
                            if (prendido == 0 && leer_boton(i) == 1) { sonido_mal(); }
                            i = i + 1;
                        }

                        __delay_ms(10);
                        contador_tiempo = contador_tiempo + 10;

                        if (contador_tiempo >= tiempo_limite) {
                            sonido_mal();
                            contador_tiempo = 0;
                        }
                    }
                }
            }

            apagar_leds();
        }

        // Modo 2: Escalado de parejas sin sonido de error
        if (modo == 2) {
            boton_modo = 0;
            apagar_leds();
            hay_led_anterior = 0;

            reproducir_mp3(10); // 0010.mp3 -> Audio de Modo 2
            __delay_ms(2000);   // Espera 2 segundos a que termine el audio antes de prender el LED

            if (modo == 2 && boton_modo == 0) {
                led1 = rand() % 10;
                prender_led(led1);
                decir_zona(led1);
            }

            while (modo == 2 && boton_modo == 0) {
                rand(); // Avanza la secuencia mientras espera el primer botón

                if (leer_boton(led1) == 1) {
                    break;
                }

                int i = 0;
                while (i < 10) {
                    int es_led1 = 0;
                    if (i == led1) { es_led1 = 1; }
                    if (es_led1 == 0 && leer_boton(i) == 1) { racha = 0; }
                    i = i + 1;
                }
            }

            while (modo == 2 && boton_modo == 0) {

                int repetido = 1;
                while (repetido == 1) {
                    led2 = rand() % 10;
                    repetido = 0;
                    if (led2 == led1) { repetido = 1; }
                    if (hay_led_anterior == 1 && led2 == led_anterior) { repetido = 1; }
                }

                __delay_ms(150);

                if (modo == 2 && boton_modo == 0) {
                    prender_led(led2);
                    decir_zona(led2);

                    int nivel_tiempo = racha / 10;
                    int tiempo_limite = 12000;

                    if (nivel_tiempo == 0) { tiempo_limite = 12000; } // 12 segundos
                    if (nivel_tiempo == 1) { tiempo_limite = 10000; } // 10 segundos
                    if (nivel_tiempo == 2) { tiempo_limite = 9000; }  // 9 segundos
                    if (nivel_tiempo > 2)  { tiempo_limite = 8000; }  // 8 segundos

                    int contador_tiempo = 0;
                    int respondio = 0;

                    while (respondio == 0 && modo == 2 && boton_modo == 0) {
                        rand(); // Avanza la secuencia mientras espera ambos botones

                        if (leer_boton(led1) == 1 && leer_boton(led2) == 1) {
                            apagar_led(led1);
                            sonido_bien();

                            led_anterior = led1;
                            hay_led_anterior = 1;
                            led1 = led2;

                            if (racha > 0 && racha % 10 == 0) {
                                prender_led(led1);
                            }

                            respondio = 1;
                        }

                        int i = 0;
                        while (i < 10) {
                            int permitido = 0;
                            if (i == led1) { permitido = 1; }
                            if (i == led2) { permitido = 1; }
                            if (hay_led_anterior == 1 && i == led_anterior) { permitido = 1; }
                            if (permitido == 0 && leer_boton(i) == 1) { racha = 0; }
                            i = i + 1;
                        }

                        __delay_ms(10);
                        contador_tiempo = contador_tiempo + 10;

                        if (contador_tiempo >= tiempo_limite) {
                            racha = 0;
                            contador_tiempo = 0;
                        }
                    }
                }
            }

            apagar_leds();
        }
    }
}
